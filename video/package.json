{
  "name": "pleory-film",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "postinstall": "node scripts/copy-fonts.mjs && node scripts/scan-assets.mjs",
    "prepare-footage": "bash scripts/prepare.sh",
    "assets": "node scripts/scan-assets.mjs",
    "studio": "npm run assets && remotion studio",
    "still": "npm run assets && remotion still",
    "render": "npm run assets && remotion render PleoryFilm ../apk/video/pleory-film.mp4 --codec=h264 --audio-codec=aac",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.541",
    "@remotion/fonts": "4.0.541",
    "pretendard": "1.3.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
