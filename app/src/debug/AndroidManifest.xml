<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.LLM_SERVICE" />

    <application>
        <!-- 디버그 화면은 adb shell(DUMP 보유)과 앱 자신만 띄운다. 다른 앱의 실행은 막는다 -->
        <!-- tools/run-demo.sh v2 녹화 중 조작(무장·탭·시동 OFF). 화면을 가리지 않게 broadcast 로 받는다 -->
        <receiver
            android:name=".debugpanel.DemoReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <provider
            android:name=".debugpanel.DemoTracker"
            android:authorities="${applicationId}.demotracker"
            android:exported="false" />
        <activity
            android:name=".proto.ProtoActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
        <activity
            android:name=".debugpanel.DebugPanelActivity"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
        <activity
            android:name=".spike.GeminiSpikeActivity"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <activity
            android:name=".spike.SpikeActivity"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>
</manifest>
